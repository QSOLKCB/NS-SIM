{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/NS-SIM/schemas/cuda-run-v1.schema.json",
  "title": "NS-SIM CUDA Run Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_status", "source_revision", "source_revision_usable",
    "experiment_hash", "canonical_reference_backend", "execution_backend", "device_ordinal",
    "initialization_environment", "environment", "provenance_lock", "precision",
    "initial_state_hash", "final_state_hash", "checkpoint_hashes", "diagnostics",
    "reproducibility", "numerical_verification_status", "physical_validation_status", "run_id"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "precision": {
      "type": "object", "additionalProperties": false,
      "required": ["dtype", "byte_order"],
      "properties": {"dtype": {"const": "float64"}, "byte_order": {"const": "little"}}
    },
    "cpu_environment": {
      "type": "object", "additionalProperties": false,
      "required": [
        "backend", "runtime_contract", "state_serialization_contract", "precision_contract",
        "python_implementation", "python_version", "numpy_version", "platform_system",
        "platform_release", "machine", "cpu_model", "byteorder", "float64_bits", "environment_identity"
      ],
      "properties": {
        "backend": {"const": "cpu-reference-v1"},
        "runtime_contract": {"type": "string", "minLength": 1},
        "state_serialization_contract": {"const": "ns-sim-state/1"},
        "precision_contract": {"$ref": "#/$defs/precision"},
        "python_implementation": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1},
        "numpy_version": {"type": "string", "minLength": 1},
        "platform_system": {"type": "string"}, "platform_release": {"type": "string"},
        "machine": {"type": "string"}, "cpu_model": {"type": "string", "minLength": 1},
        "byteorder": {"enum": ["little", "big"]}, "float64_bits": {"const": 64},
        "environment_identity": {"$ref": "#/$defs/sha256"}
      }
    },
    "cuda_environment": {
      "type": "object", "additionalProperties": false,
      "required": [
        "backend", "device_ordinal", "device_uuid", "pci_bus_id", "gpu_name", "compute_capability",
        "total_global_memory_bytes", "cuda_driver_version", "cupy_linked_cuda_runtime_version",
        "local_cuda_runtime_version", "cupy_version", "numpy_version", "python_implementation",
        "python_version", "platform_system", "platform_release", "machine", "byteorder",
        "precision_contract", "single_gpu", "tf32_or_mixed_precision", "environment_identity"
      ],
      "properties": {
        "backend": {"const": "cuda-single-gpu-v1"}, "device_ordinal": {"type": "integer", "minimum": 0},
        "device_uuid": {"type": "string", "minLength": 1}, "pci_bus_id": {"type": "string", "minLength": 1},
        "gpu_name": {"type": "string", "minLength": 1},
        "compute_capability": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "minItems": 2, "maxItems": 2},
        "total_global_memory_bytes": {"type": "integer", "minimum": 1},
        "cuda_driver_version": {"type": "integer", "minimum": 0},
        "cupy_linked_cuda_runtime_version": {"type": "integer", "minimum": 0},
        "local_cuda_runtime_version": {"type": ["integer", "null"], "minimum": 0},
        "cupy_version": {"type": "string", "minLength": 1}, "numpy_version": {"type": "string", "minLength": 1},
        "python_implementation": {"type": "string", "minLength": 1}, "python_version": {"type": "string", "minLength": 1},
        "platform_system": {"type": "string"}, "platform_release": {"type": "string"}, "machine": {"type": "string"},
        "byteorder": {"enum": ["little", "big"]}, "precision_contract": {"$ref": "#/$defs/precision"},
        "single_gpu": {"const": true}, "tf32_or_mixed_precision": {"const": false},
        "environment_identity": {"$ref": "#/$defs/sha256"}
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["step", "path", "sha256"],
      "properties": {"step": {"type": "integer", "minimum": 0}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["step", "time", "finite_state", "divergence_linf", "divergence_l2", "kinetic_energy_mean", "enstrophy_mean", "max_abs_u", "max_abs_v", "advective_cfl", "diffusion_number", "pressure_iterations", "pressure_residual_linf"],
      "properties": {
        "step": {"type": "integer", "minimum": 0}, "time": {"type": "number", "minimum": 0}, "finite_state": {"const": true},
        "divergence_linf": {"type": "number", "minimum": 0}, "divergence_l2": {"type": "number", "minimum": 0},
        "kinetic_energy_mean": {"type": "number", "minimum": 0}, "enstrophy_mean": {"type": "number", "minimum": 0},
        "max_abs_u": {"type": "number", "minimum": 0}, "max_abs_v": {"type": "number", "minimum": 0},
        "advective_cfl": {"type": "number", "minimum": 0}, "diffusion_number": {"type": "number", "minimum": 0},
        "pressure_iterations": {"type": "integer", "minimum": 0}, "pressure_residual_linf": {"type": "number", "minimum": 0}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "ns-sim-cuda-run/1"}, "run_status": {"const": "completed"},
    "source_revision": {"type": "string", "minLength": 1}, "source_revision_usable": {"type": "boolean"},
    "experiment_hash": {"$ref": "#/$defs/sha256"}, "canonical_reference_backend": {"const": "cpu-reference-v1"},
    "execution_backend": {"const": "cuda-single-gpu-v1"}, "device_ordinal": {"type": "integer", "minimum": 0},
    "initialization_environment": {"$ref": "#/$defs/cpu_environment"}, "environment": {"$ref": "#/$defs/cuda_environment"},
    "provenance_lock": {"type": "object"}, "precision": {"$ref": "#/$defs/precision"},
    "initial_state_hash": {"$ref": "#/$defs/sha256"}, "final_state_hash": {"$ref": "#/$defs/sha256"},
    "checkpoint_hashes": {"type": "array", "items": {"$ref": "#/$defs/checkpoint"}},
    "diagnostics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/diagnostic"}},
    "reproducibility": {
      "type": "object", "additionalProperties": false,
      "required": ["demonstrated", "R1_initialization_environment_identity", "R2_status", "R3_status"],
      "properties": {
        "demonstrated": {"const": ["R0", "R1"]}, "R1_initialization_environment_identity": {"$ref": "#/$defs/sha256"},
        "R2_status": {"const": "not_assessed_by_single_execution"}, "R3_status": {"const": "not_assessed_by_single_execution"}
      }
    },
    "numerical_verification_status": {"const": "candidate_backend_run_only"},
    "physical_validation_status": {"const": "not_claimed"}, "run_id": {"$ref": "#/$defs/sha256"}
  }
}
