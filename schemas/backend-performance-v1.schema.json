{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/NS-SIM/schemas/backend-performance-v1.schema.json",
  "title": "NS-SIM CPU CUDA Backend Performance Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_revision", "experiment_hash", "verification_gate",
    "reference_backend", "candidate_backend", "warmup_runs", "timed_repeats",
    "observed_speedup_cpu_over_cuda", "performance_scope", "physical_validation_status"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timed_backend": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "environment", "durations_seconds", "median_seconds"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "environment": {"type": "object"},
        "durations_seconds": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
        "median_seconds": {"type": "number", "minimum": 0}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "ns-sim-backend-performance/1"},
    "source_revision": {"type": "string", "minLength": 1},
    "experiment_hash": {"$ref": "#/$defs/sha256"},
    "verification_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "passed", "comparison_schema", "comparison_contract_identity", "R3_status"],
      "properties": {
        "required": {"const": true}, "passed": {"const": true},
        "comparison_schema": {"const": "ns-sim-backend-comparison/1"},
        "comparison_contract_identity": {"$ref": "#/$defs/sha256"}, "R3_status": {"const": "demonstrated"}
      }
    },
    "reference_backend": {"allOf": [{"$ref": "#/$defs/timed_backend"}, {"properties": {"name": {"const": "cpu-reference-v1"}}}]},
    "candidate_backend": {"allOf": [{"$ref": "#/$defs/timed_backend"}, {"properties": {"name": {"const": "cuda-single-gpu-v1"}}}]},
    "warmup_runs": {"type": "integer", "minimum": 0}, "timed_repeats": {"type": "integer", "minimum": 1},
    "observed_speedup_cpu_over_cuda": {"type": ["number", "null"], "minimum": 0},
    "performance_scope": {"type": "string", "minLength": 1},
    "physical_validation_status": {"const": "not_claimed"}
  }
}
