{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/NS-SIM/schemas/receipt-v1.schema.json",
  "title": "NS-SIM Phase 1 Run Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "run_status", "ns_sim_version", "source_revision", "experiment_name", "experiment_hash", "model", "backend", "reproducibility", "initial_state_hash", "final_state_hash", "checkpoint_hashes", "diagnostics", "numerical_verification_status", "physical_validation_status"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "precision": {"type": "object", "additionalProperties": false, "required": ["dtype", "byte_order"], "properties": {"dtype": {"const": "float64"}, "byte_order": {"const": "little"}}},
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "runtime_contract", "state_serialization_contract", "precision_contract", "python_implementation", "python_version", "numpy_version", "platform_system", "platform_release", "machine", "cpu_model", "byteorder", "float64_bits", "environment_identity"],
      "properties": {
        "backend": {"const": "cpu-reference-v1"}, "runtime_contract": {"const": "ns-sim/0.1.0"}, "state_serialization_contract": {"const": "ns-sim-state/1"},
        "precision_contract": {"$ref": "#/$defs/precision"}, "python_implementation": {"type": "string", "minLength": 1}, "python_version": {"type": "string", "minLength": 1},
        "numpy_version": {"type": "string", "minLength": 1}, "platform_system": {"type": "string"}, "platform_release": {"type": "string"}, "machine": {"type": "string"},
        "cpu_model": {"type": "string", "minLength": 1}, "byteorder": {"enum": ["little", "big"]}, "float64_bits": {"const": 64}, "environment_identity": {"$ref": "#/$defs/sha256"}
      }
    },
    "checkpoint": {"type": "object", "additionalProperties": false, "required": ["step", "path", "sha256"], "properties": {"step": {"type": "integer", "minimum": 0}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["step", "time", "finite_state", "divergence_linf", "divergence_l2", "kinetic_energy_mean", "enstrophy_mean", "max_abs_u", "max_abs_v", "advective_cfl", "diffusion_number", "pressure_iterations", "pressure_residual_linf"],
      "properties": {
        "step": {"type": "integer", "minimum": 0}, "time": {"type": "number", "minimum": 0}, "finite_state": {"const": true}, "divergence_linf": {"type": "number", "minimum": 0},
        "divergence_l2": {"type": "number", "minimum": 0}, "kinetic_energy_mean": {"type": "number", "minimum": 0}, "enstrophy_mean": {"type": "number", "minimum": 0},
        "max_abs_u": {"type": "number", "minimum": 0}, "max_abs_v": {"type": "number", "minimum": 0}, "advective_cfl": {"type": "number", "minimum": 0},
        "diffusion_number": {"type": "number", "minimum": 0}, "pressure_iterations": {"type": "integer", "minimum": 0}, "pressure_residual_linf": {"type": "number", "minimum": 0}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "ns-sim-receipt/1"}, "run_id": {"$ref": "#/$defs/sha256"}, "run_status": {"const": "completed"}, "ns_sim_version": {"const": "0.1.0"},
    "source_revision": {"type": "string", "minLength": 1}, "experiment_name": {"type": "string", "minLength": 1}, "experiment_hash": {"$ref": "#/$defs/sha256"},
    "model": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "incompressible-navier-stokes-2d"}, "version": {"const": "1"}}},
    "backend": {"type": "object", "additionalProperties": false, "required": ["name", "precision", "environment"], "properties": {"name": {"const": "cpu-reference-v1"}, "precision": {"$ref": "#/$defs/precision"}, "environment": {"$ref": "#/$defs/environment"}}},
    "reproducibility": {"type": "object", "additionalProperties": false, "required": ["target", "demonstrated", "R2_status"], "properties": {"target": {"enum": ["R1", "R2"]}, "demonstrated": {"const": ["R0", "R1"]}, "R2_status": {"const": "not_demonstrated_by_single_execution"}}},
    "initial_state_hash": {"$ref": "#/$defs/sha256"}, "final_state_hash": {"$ref": "#/$defs/sha256"}, "checkpoint_hashes": {"type": "array", "items": {"$ref": "#/$defs/checkpoint"}},
    "diagnostics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/diagnostic"}}, "numerical_verification_status": {"type": "string", "minLength": 1}, "physical_validation_status": {"const": "not_claimed"}
  }
}
